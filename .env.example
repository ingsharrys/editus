APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Facebook / Meta ---
# Credenciales de la app en https://developers.facebook.com
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0

# Login básico (solo email/perfil)
FACEBOOK_LOGIN_REDIRECT_URI="${APP_URL}/auth/facebook/login/callback"
FACEBOOK_LOGIN_SCOPES=email,public_profile
FACEBOOK_LOGIN_CONFIG_ID=

# Conexión/sincronización de páginas.
# La URL debe estar registrada en Meta: Configuración de la app >
# Inicio de sesión con Facebook > URI de redireccionamiento de OAuth válidos.
FACEBOOK_LINK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
FACEBOOK_LINK_SCOPES=email,public_profile,pages_show_list,pages_manage_posts,pages_manage_metadata,pages_read_engagement,read_insights,business_management
FACEBOOK_LINK_CONFIG_ID=

# Opcional: token de usuario de sistema (Business Manager) para reparar tokens
FACEBOOK_SYSTEM_USER_TOKEN=

# Integración con el sistema de noticias (backend.esnoticia.org)
# Genera el token con: php -r "echo bin2hex(random_bytes(24));"
# (el MISMO valor va en EDITUS_TOKEN del .env del backend de noticias)
EDITUS_INGEST_TOKEN=
# Usuario de editus al que se atribuyen los posts publicados por API
EDITUS_API_USER_ID=1
